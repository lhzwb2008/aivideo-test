# cp .env.example .env  或从 ../aivideo/.env 复制后按需修改

# ── LLM 文案（AiHubMix / Claude）──
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_TEXT_MODEL=claude-opus-4-8

# ── 热点检索（焦虑类脚本可选）──
EXA_API_KEY=
EXA_TIMEOUT=180

# ── 免费视频素材（推荐注册 https://www.pexels.com/api/ ）──
# 无 Key 时使用 demos/fallback_clips.json 里的 Pexels 直链
PEXELS_API_KEY=

# ── TTS（与 aivideo 相同，默认豆包）──
TTS_PROVIDER=doubao
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_RESOURCE_ID=seed-icl-2.0
VOLCENGINE_TTS_SPEAKER=S_6uN8A8f22
VOLCENGINE_TTS_MODEL=seed-tts-2.0-standard
VOLCENGINE_TTS_ATEMPO=1.15

# ── 合成 ──
AIVIDEO_FONT=assets/HiraginoSansGB.ttc
AIVIDEO_SUBTITLE_Y=1580
AIVIDEO_BGM_ENABLED=1
AIVIDEO_BGM_DIR=assets/bgm
AIVIDEO_BGM_VOLUME=0.28

# 本实验项目默认不自动发布
AIVIDEO_PUBLISH_YOUTUBE=0
AIVIDEO_PUBLISH_TIKTOK=0
